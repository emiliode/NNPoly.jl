{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Julia in flake",
            "type": "shell",
            "command": "nix",
            "args": [
                "develop",
                "--command",
                "julia",
                "--project=.",
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}